{
  "name": "@lickle/docs",
  "description": "Documentation generation for lickle",
  "version": "0.2.3",
  "author": "Dan Beaven <dm.beaven@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pingid/lickle-docs.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/ui/index.cjs",
  "types": "dist/ui/index.d.mts",
  "module": "dist/ui/index.mjs",
  "sideEffects": false,
  "bin": {
    "ldocs": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/ts/ui/index.d.ts",
      "import": "./dist/esm/ui/index.js",
      "require": "./dist/esm/ui/index.js"
    },
    "./theme.css": "./theme.css",
    "./client": "./client.d.ts",
    "./preset": {
      "types": "./dist/ts/preset/index.d.ts",
      "import": "./dist/esm/preset/index.jsx",
      "require": "./dist/esm/preset/index.jsx"
    },
    "./ui": {
      "types": "./dist/ts/ui/index.d.ts",
      "import": "./dist/esm/ui/index.js",
      "require": "./dist/esm/ui/index.js"
    },
    "./preset/tsconfig.json": "./tsconfig.client.json",
    "./preset/jsx-runtime": "./dist/ts/preset/solidjs/jsx-runtime.d.ts"
  },
  "scripts": {
    "build": "pnpm tsc"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.9.1",
    "prettier": "^3.8.3",
    "sucrase": "^3.35.1",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "dependencies": {
    "@lickle/docs": "link:",
    "@orama/orama": "^3.1.18",
    "@solidjs/router": "^0.16.1",
    "@tailwindcss/vite": "^4.3.0",
    "cmd-ts": "^0.15.0",
    "codejar": "^4.3.0",
    "fast-glob": "^3.3.3",
    "marked": "^18.0.4",
    "micromatch": "^4.0.8",
    "shiki": "^4.1.0",
    "solid-js": "^1.9.13",
    "tailwindcss": "^4.3.0",
    "typedoc": "^0.28.19",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.12"
  }
}
