{
  "name": "@lickle/docs",
  "description": "Documentation generation for lickle",
  "version": "0.2.3",
  "author": "Dan Beaven <dm.beaven@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pingid/lickle-docs.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/ui/index.cjs",
  "types": "dist/ui/index.d.mts",
  "module": "dist/ui/index.mjs",
  "sideEffects": false,
  "bin": {
    "ldocs": "./src/cli.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.mjs",
      "require": "./dist/ui/index.cjs"
    },
    "./preset": {
      "types": "./dist/preset/index.d.ts",
      "import": "./dist/preset/index.mjs",
      "require": "./dist/preset/index.cjs"
    },
    "./preset/tsconfig.json": "./tsconfig.client.json",
    "./preset/jsx-runtime": "./dist/preset/solidjs/jsx-runtime.d.ts"
  },
  "scripts": {
    "build": "pnpm tsc && pnpm build:tools && pnpm build:lib",
    "build:tools": "tsc -p ./build/tsconfig.json && tsc -p ./build/tsconfig.cjs.json",
    "build:lib": "tsc -p ./tsconfig.esm.json && tsc -p ./tsconfig.cjs.json",
    "format": "prettier --write .",
    "generate": "npm run build:tools && node ./generate.js",
    "build:docs": "pnpm -C ./typedoc build",
    "watch:docs": "pnpm -C ./typedoc watch"
  },
  "devDependencies": {
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.9.1",
    "prettier": "^3.8.3",
    "sucrase": "^3.35.1",
    "typescript": "^6.0.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "all"
  },
  "dependencies": {
    "@orama/orama": "^3.1.18",
    "@solidjs/router": "^0.16.1",
    "@tailwindcss/vite": "^4.3.0",
    "cmd-ts": "^0.15.0",
    "codejar": "^4.3.0",
    "fast-glob": "^3.3.3",
    "marked": "^18.0.4",
    "micromatch": "^4.0.8",
    "shiki": "^4.1.0",
    "solid-js": "^1.9.13",
    "tailwindcss": "^4.3.0",
    "typedoc": "^0.28.19",
    "unbuild": "^3.6.1",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.12"
  }
}
