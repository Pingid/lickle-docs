{
  "name": "@lickle/docs",
  "description": "Documentation generation for lickle",
  "version": "0.0.0-dev.1",
  "author": "Dan Beaven <dm.beaven@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Pingid/lickle-docs.git"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/ui/index.cjs",
  "types": "dist/ui/index.d.mts",
  "module": "dist/ui/index.mjs",
  "sideEffects": false,
  "bin": {
    "ldocs": "./src/cli.ts"
  },
  "exports": {
    "./config": {
      "types": "./dist/ts/config/index.d.ts",
      "import": "./dist/esm/config/index.js",
      "require": "./dist/esm/config/index.js"
    },
    "./ui": {
      "types": "./dist/ts/ui/index.d.ts",
      "import": "./dist/esm/ui/index.js",
      "require": "./dist/esm/ui/index.js"
    },
    "./solidjs": {
      "types": "./dist/ts/solidjs/index.d.ts",
      "import": "./dist/esm/solidjs/index.js",
      "require": "./dist/esm/solidjs/index.js"
    },
    "./client": "./client.d.ts",
    "./theme.css": "./theme.css",
    "./tsconfig.client.json": "./tsconfig.client.json",
    "./solidjs/jsx-runtime": "./dist/ts/solidjs/jsx-runtime.d.ts"
  },
  "scripts": {
    "build": "pnpm tsc",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning 'test/**/*.test.ts'"
  },
  "dependencies": {
    "@lickle/docs": "link:",
    "@lickle/is": "0.1.0-dev.10",
    "@orama/orama": "^3.1.18",
    "@solidjs/router": "^0.16.1",
    "@tailwindcss/vite": "^4.3.0",
    "cmd-ts": "^0.15.0",
    "codejar": "^4.3.0",
    "fast-glob": "^3.3.3",
    "get-tsconfig": "^4.14.0",
    "jiti": "^2.7.0",
    "marked": "^18.0.4",
    "micromatch": "^4.0.8",
    "pkg-exports": "^0.2.0",
    "resolve.exports": "^2.0.3",
    "hosted-git-info": "^10.1.1",
    "shiki": "^4.1.0",
    "solid-js": "^1.9.13",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.12"
  },
  "devDependencies": {
    "@types/hosted-git-info": "^3.0.5",
    "@types/micromatch": "^4.0.10",
    "@types/node": "^25.9.1",
    "prettier": "^3.8.3"
  },
  "prettier": {
    "semi": false,
    "singleQuote": true,
    "printWidth": 120,
    "trailingComma": "all"
  }
}
